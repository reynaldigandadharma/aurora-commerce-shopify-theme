<section class="section page-width">
  <div class="story-card">
    <div class="story-media">
      {% if section.settings.image %}
        {{ section.settings.image | image_url: width: 1600 | image_tag:
          loading: 'lazy',
          widths: '540, 800, 1200, 1600',
          sizes: '(min-width: 900px) 55vw, 100vw',
          alt: section.settings.image.alt
        }}
      {% else %}
        <img
          src="{{ 'aurora-craftsmanship.png' | asset_url }}"
          alt="Aurora artisan craftsmanship"
          width="1536"
          height="1024"
          loading="lazy"
        >
      {% endif %}
    </div>
    <div class="story-copy">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <div class="story-text">{{ section.settings.text }}</div>
      <div class="story-stats">
        <div><strong>{{ section.settings.stat_one }}</strong><span>{{ section.settings.stat_one_label }}</span></div>
        <div><strong>{{ section.settings.stat_two }}</strong><span>{{ section.settings.stat_two_label }}</span></div>
      </div>
      {% if section.settings.button_label != blank %}
        <a class="text-link" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} <span aria-hidden="true">&rarr;</span></a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial story",
  "settings": [
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"OUR APPROACH"},
    {"type":"text","id":"heading","label":"Heading","default":"Considered design, made to live with."},
    {"type":"richtext","id":"text","label":"Text","default":"<p>We choose enduring materials and thoughtful details to create pieces that become more personal with every use.</p>"},
    {"type":"text","id":"stat_one","label":"First statistic","default":"100%"},
    {"type":"text","id":"stat_one_label","label":"First statistic label","default":"Responsibly sourced"},
    {"type":"text","id":"stat_two","label":"Second statistic","default":"2 yr"},
    {"type":"text","id":"stat_two_label","label":"Second statistic label","default":"Craft warranty"},
    {"type":"text","id":"button_label","label":"Button label","default":"Discover our story"},
    {"type":"url","id":"button_link","label":"Button link"}
  ],
  "presets":[{"name":"Editorial story"}]
}
{% endschema %}
