<div class="announcement">
  <div class="page-width announcement-inner">
    <span>{{ section.settings.text }}</span>
    {% if section.settings.link_label != blank %}
      <a href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {"type":"text","id":"text","label":"Text","default":"Free shipping on selected orders"},
    {"type":"text","id":"link_label","label":"Link label","default":"Shop now"},
    {"type":"url","id":"link","label":"Link"}
  ]
}
{% endschema %}
