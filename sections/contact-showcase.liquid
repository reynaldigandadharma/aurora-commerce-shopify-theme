<section class="section contact-section" id="contact">
  <div class="page-width">
    <div class="contact-shell">
      <div class="contact-intro">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <div class="contact-description">{{ section.settings.text }}</div>

        <div class="contact-details">
          <div>
            <span class="contact-detail-label">Email</span>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </div>
          <div>
            <span class="contact-detail-label">Response time</span>
            <span>{{ section.settings.response_time }}</span>
          </div>
          <div>
            <span class="contact-detail-label">Based in</span>
            <span>{{ section.settings.location }}</span>
          </div>
        </div>

        <div class="contact-note">
          <span aria-hidden="true">&#10022;</span>
          <p>{{ section.settings.note }}</p>
        </div>
      </div>

      <div class="contact-form-card">
        {% form 'contact', id: 'ContactForm' %}
          {% if form.posted_successfully? %}
            <div class="form-status form-success" tabindex="-1" autofocus>
              <strong>Message received.</strong>
              <p>Thank you for reaching out. We will get back to you shortly.</p>
            </div>
          {% elsif form.errors %}
            <div class="form-status form-error" role="alert">
              <strong>Please check the highlighted fields.</strong>
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="contact-field-row">
            <div class="contact-field">
              <label for="ContactName">Name</label>
              <input id="ContactName" type="text" name="contact[name]" value="{{ form.name | escape }}" autocomplete="name" placeholder="Your name">
            </div>
            <div class="contact-field">
              <label for="ContactEmail">Email <span aria-hidden="true">*</span></label>
              <input id="ContactEmail" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="you@example.com" required>
            </div>
          </div>

          <div class="contact-field">
            <label for="ContactTopic">How can we help?</label>
            <select id="ContactTopic" name="contact[topic]">
              <option>Product question</option>
              <option>Order support</option>
              <option>Returns & exchanges</option>
              <option>Wholesale enquiry</option>
              <option>Something else</option>
            </select>
          </div>

          <div class="contact-field">
            <label for="ContactMessage">Message <span aria-hidden="true">*</span></label>
            <textarea id="ContactMessage" name="contact[body]" rows="6" placeholder="Tell us a little more..." required>{{ form.body }}</textarea>
          </div>

          <button class="button button-full contact-submit" type="submit">
            Send message <span aria-hidden="true">&rarr;</span>
          </button>
          <p class="contact-privacy">By submitting this form, you agree that we may use your details to respond to your enquiry.</p>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact showcase",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"GET IN TOUCH"},
    {"type":"text","id":"heading","label":"Heading","default":"We would love to hear from you."},
    {"type":"richtext","id":"text","label":"Text","default":"<p>Questions about a product, an existing order, or a future collaboration? Send us a note and our team will help.</p>"},
    {"type":"text","id":"email","label":"Email","default":"hello@auroracommerce.com"},
    {"type":"text","id":"response_time","label":"Response time","default":"Within 1–2 business days"},
    {"type":"text","id":"location","label":"Location","default":"Tegal, Indonesia"},
    {"type":"textarea","id":"note","label":"Side note","default":"Thoughtful support from real people, from first question to aftercare."}
  ],
  "presets":[{"name":"Contact showcase"}]
}
{% endschema %}
