{% assign collection = section.settings.collection %}
<section class="section page-width">
  <div class="section-header">
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {% if collection %}
      <a href="{{ collection.url }}">View all</a>
    {% endif %}
  </div>
  <div class="product-grid">
    {% if collection %}
      {% for product in collection.products limit: section.settings.limit %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <article class="product-card placeholder-card">
          <div class="product-media">
            {{ 'aurora-product-placeholder.png' | asset_url | image_tag: loading: 'lazy', alt: 'Aurora leather tote' }}
            {% if i == 1 %}<span class="badge">Bestseller</span>{% endif %}
          </div>
          <div class="product-meta"><strong>Aurora Carryall {{ i }}</strong><span>Rp 1.299.000</span></div>
        </article>
      {% endfor %}
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name":"Featured collection",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"FEATURED"},
    {"type":"text","id":"heading","label":"Heading","default":"Shop the collection"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"limit","label":"Products to show","min":2,"max":8,"step":1,"default":4}
  ],
  "presets":[{"name":"Featured collection"}]
}
{% endschema %}
