<section class="section page-width">
  <div class="section-header collection-title">
    <div>
      <p class="eyebrow">COLLECTION</p>
      <h1>{{ collection.title }}</h1>
      {% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}
    </div>
  </div>

  <form class="sort-form">
    <label for="SortBy">Sort by</label>
    <select id="SortBy" name="sort_by" onchange="this.form.submit()">
      {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
      {% for option in collection.sort_options %}
        <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
      {% endfor %}
    </select>
  </form>

  <div class="product-grid">
    {% for product in collection.products %}
      {% render 'product-card', product: product %}
    {% else %}
      <p>No products found.</p>
    {% endfor %}
  </div>
</section>
{% schema %}{"name":"Main collection"}{% endschema %}
