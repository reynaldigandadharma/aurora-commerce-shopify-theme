<section class="section page-width">
  <div class="value-grid">
    {% for block in section.blocks %}
      <article class="value-card" {{ block.shopify_attributes }}>
        <span class="value-icon">{{ block.settings.icon }}</span>
        <h3>{{ block.settings.heading }}</h3>
        <p>{{ block.settings.text }}</p>
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name":"Value propositions",
  "blocks":[
    {
      "type":"item",
      "name":"Item",
      "settings":[
        {"type":"text","id":"icon","label":"Icon","default":"✦"},
        {"type":"text","id":"heading","label":"Heading","default":"Flexible sections"},
        {"type":"textarea","id":"text","label":"Text","default":"Reusable merchant-editable components."}
      ]
    }
  ],
  "max_blocks":4,
  "presets":[{"name":"Value propositions","blocks":[{"type":"item"},{"type":"item"},{"type":"item"}]}]
}
{% endschema %}
